#!/bin/sh
set -eu
# Guard that this chroot hook only executes on ephemeral live-session media.
test -f /etc/spicy/live-image
# live-config only creates the session account when this package is present.
test -x /usr/lib/user-setup/user-setup-apply
plymouth-set-default-theme spicy
update-initramfs -u -k all
systemctl enable sddm.service

# Real SDDM autologin config for the live session (not documentation-only).
# Resolve the live username the same way live-config does when present.
live_user=spicy
if [ -r /etc/live/config.conf ]; then
	# shellcheck disable=SC1091
	. /etc/live/config.conf
fi
if [ -n "${LIVE_USERNAME:-}" ]; then
	live_user=$LIVE_USERNAME
fi
install -d -m 0755 /etc/sddm.conf.d
cat > /etc/sddm.conf.d/20-spicy.conf <<CFG
# Generated by 0200-spicy.hook.chroot for the ephemeral live session only.
# spicy-purge-live-autologin removes this file when /etc/spicy/live-image is gone.
[Theme]
Current=spicy

[Autologin]
User=${live_user}
Session=plasma.desktop
Relogin=false
CFG

install -d -m 0755 /usr/lib/spicy
install -d -m 0755 /etc/systemd/system
cat > /usr/lib/spicy/purge-live-autologin <<'PURGE'
#!/bin/sh
set -eu
# Drop passwordless SDDM Autologin outside the ephemeral live image.
if [ -f /etc/spicy/live-image ]; then
	exit 0
fi
rm -f /etc/sddm.conf.d/20-spicy.conf
PURGE
chmod 0755 /usr/lib/spicy/purge-live-autologin
cat > /etc/systemd/system/spicy-purge-live-autologin.service <<'UNIT'
[Unit]
Description=Remove Spicy live SDDM Autologin outside live images
DefaultDependencies=no
Before=sddm.service
ConditionPathExists=!/etc/spicy/live-image
ConditionPathExists=/etc/sddm.conf.d/20-spicy.conf

[Service]
Type=oneshot
ExecStart=/usr/lib/spicy/purge-live-autologin
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT
systemctl enable spicy-purge-live-autologin.service
