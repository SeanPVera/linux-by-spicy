#!/bin/sh
set -eu
if [ "$1" = configure ]; then
    owner="$(dpkg-divert --listpackage /etc/os-release)"
    if [ -n "$owner" ] && [ "$owner" != spicy-release ]; then
        echo 'Another package already manages /etc/os-release through a diversion.' >&2
        exit 1
    fi
    if [ -z "$owner" ]; then
        dpkg-divert --package spicy-release --add --rename --divert /etc/os-release.debian /etc/os-release
        ln -snf /usr/lib/spicy/os-release /etc/os-release
    elif [ ! -e /etc/os-release ] || [ "$(readlink /etc/os-release 2>/dev/null || true)" = /usr/lib/spicy/os-release ]; then
        ln -snf /usr/lib/spicy/os-release /etc/os-release
    fi
fi
