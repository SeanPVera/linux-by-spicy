#!/bin/sh
set -eu
case "$1" in
    remove|purge|abort-install)
        if [ "$(dpkg-divert --listpackage /etc/os-release)" = spicy-release ]; then
            if [ "$(readlink /etc/os-release 2>/dev/null || true)" = /usr/lib/spicy/os-release ]; then
                # -f so a missing symlink is not an error during cleanup.
                rm -f /etc/os-release
            fi
            if [ ! -e /etc/os-release ] && [ ! -L /etc/os-release ]; then
                dpkg-divert --package spicy-release --remove --rename --divert /etc/os-release.debian /etc/os-release
            fi
        fi
        ;;
esac
